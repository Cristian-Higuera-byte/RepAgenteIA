# Variables de entorno de ejemplo. Copiar este archivo como `.env` y reemplazar los valores.
# El archivo `.env` NUNCA debe subirse a git: contiene claves secretas.

# ── Inteligencia artificial (obligatoria) ─────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=sk-reemplazar-por-tu-clave
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── Bróker: "capital" (API REST de Capital.com, sin terminal) o "mt5" (solo Windows) ──────────────────
PROVEEDOR=capital
# MT5_PATH=C:\\Program Files\\MetaTrader 5\\terminal64.exe     # solo con PROVEEDOR=mt5

# Un solo usuario: la cuenta se define aquí. (Con CAPITAL_MULTIUSUARIO=true cada usuario conecta la suya en la plataforma.)
CAPITAL_DEMO=true
CAPITAL_API_KEY=reemplazar
CAPITAL_IDENTIFIER=correo@ejemplo.com
CAPITAL_API_PASSWORD=reemplazar-contrasena-de-la-api-key

# ── Base de datos: "supabase" (por defecto) o "postgres" ──────────────────────────────────────────────
BASE_DATOS=supabase
SUPABASE_URL=https://reemplazar.supabase.co
SUPABASE_KEY=reemplazar

# Si BASE_DATOS=postgres:
# POSTGRES_SERVIDOR=servidor-de-la-base
# POSTGRES_PUERTO=5432
# POSTGRES_BASE_DATOS=nombre-de-la-base
# POSTGRES_USUARIO=usuario
# POSTGRES_CONTRASENA=reemplazar

# ── Modo multiusuario (cada usuario conecta su cuenta de Capital.com) ─────────────────────────────────
# CAPITAL_MULTIUSUARIO=true
# SERVIDOR_SECRETO=      # mínimo 32 caracteres. Generar: python -c "from herramientas.token_datos import generar_secreto; print(generar_secreto())"
# CREDENCIALES_CLAVES=   # clave Fernet. Generar: python -c "from herramientas.credenciales_bolsa import generar_clave; print(generar_clave())"
# CAPITAL_MAX_SESIONES=200
# SERVIDOR_ORIGENES=mi-dominio.cl      # solo en producción: dominios desde los que se consulta el servidor de precios

# ── Correo: verificación de correo y recuperación de contraseña ───────────────────────────────────────
# VERIFICACION_CORREO=true
# PLATAFORMA_URL=https://mi-dominio.cl
# CORREO_SERVIDOR=smtp.ejemplo.com
# CORREO_PUERTO=465
# CORREO_SEGURIDAD=ssl                 # ssl (465) o starttls (587)
# CORREO_USUARIO=buzon@ejemplo.com
# CORREO_CLAVE=reemplazar
# CORREO_REMITENTE=Nombre que ve quien recibe
# CORREO_VERIFICAR_CERTIFICADO=true    # false solo si el certificado del servidor de correo no coincide con su nombre y se confía en él
# SOPORTE_CORREO=soporte@ejemplo.com

# ── Servidor de precios ───────────────────────────────────────────────────────────────────────────────
# MT5_API_URL=http://localhost:8000    # dirección que usa el navegador para consultar el servidor de precios
# SERVIDOR_HOST=127.0.0.1              # en Docker ya se define como 0.0.0.0

# --- Despliegue en contenedor ---
# PUERTO_DASHBOARD=8501      # puerto interno del dashboard (cambiar solo si se modifica también docker-compose.yml)
